CONFIG_BT_ATH3K=y
CONFIG_BT_HCIBTSDIO=m
CONFIG_BT_INTEL=y
CONFIG_BT_BCM=y
CONFIG_BT_RTL=y
CONFIG_BT_QCA=y

# ===== NETWORK PROTOCOLS =====
