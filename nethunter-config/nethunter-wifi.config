# NetHunter WiFi Injection & Monitor Mode Config
# OnePlus 12 (SM8650) — External USB adapter support

CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_NL80211_TESTMODE=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y

# Realtek RTL8812AU / RTL8821AU (most popular for injection)
CONFIG_RTLWIFI=m
CONFIG_RTLWIFI_USB=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y

# Ralink / MediaTek
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT53XX=m
CONFIG_RT2800USB_RT55XX=m
CONFIG_RT2800USB_UNKNOWN=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7601U=m
CONFIG_MT7612U=m
CONFIG_MT7663U=m
CONFIG_MT7921U=m

# Atheros
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_MESH=y
CONFIG_ATH9K_HW=m
CONFIG_ATH9K_COMMON=m
CONFIG_ATH9K_BTCOEX_SUPPORT=y
CONFIG_ATH10K=m
CONFIG_ATH10K_USB=m
CONFIG_ATH10K_DEBUG=n
CONFIG_CARL9170=m
CONFIG_AR5523=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m

# ZyDAS
CONFIG_ZD1211RW=m

# Marvell
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_USB=m
CONFIG_LIBERTAS_MESH=y

# Enforce monitor/injection API
CONFIG_CFG80211_CERTIFICATION_ONUS=y
